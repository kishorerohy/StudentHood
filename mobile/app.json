{
  "expo": {
    "name": "StudentHood",
    "slug": "studenthood",
    "scheme": "studenthood",
    "version": "0.2.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studenthood.app",
      "entitlements": {
        "com.apple.developer.declared-age-range": true
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "instagram",
          "snssdk1233",
          "tiktok",
          "whatsapp"
        ]
      }
    },
    "android": {
      "package": "com.studenthood.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D0F",
        "foregroundImage": "assets/studenthood-app-icon-foreground.png"
      },
      "versionCode": 11,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "StudentHood uses your photo library only when you choose a photo or video for a Scene.",
          "cameraPermission": "StudentHood uses your camera only when you choose to create a photo or video."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "StudentHood uses your location during profile setup to find your city and nearby schools, colleges and universities. Your precise location is not stored."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/studenthood-notification.wav"
          ],
          "defaultChannel": "studenthood-drops-v1",
          "color": "#5FC5BE"
        }
      ],
      "./plugins/withSocialShareQueries",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/studenthood-native-blank.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/studenthood-native-blank.png"
          }
        }
      ]
    ],
    "extra": {
      "privacyUrl": "https://kishorerohy.github.io/StudentHood/privacy.html",
      "termsUrl": "https://kishorerohy.github.io/StudentHood/terms.html",
      "safetyUrl": "https://kishorerohy.github.io/StudentHood/safety.html",
      "eas": {
        "projectId": "2a76faaf-95de-438c-a4f5-f4f33a3dbcd3"
      }
    },
    "icon": "assets/studenthood-app-icon-compact-1024.png",
    "owner": "studenthood-0920",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    }
  }
}
